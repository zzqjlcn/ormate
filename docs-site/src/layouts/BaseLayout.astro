---
import "../styles/global.css";

interface DocEntry {
  id: string;
  data: { title: string; description: string; kicker: string; order: number };
}

interface Props {
  title?: string;
  description?: string;
  docs: DocEntry[];
  pageKind?: "home" | "docs";
}

const {
  title = "ormate · Unified repositories for Python",
  description = "ormate 0.1.2 官方文档：使用统一 Repository API 访问 SQLAlchemy、SQLModel 与 Elasticsearch。",
  docs,
  pageKind = "docs",
} = Astro.props;

const orderedDocs = [...docs].sort((a, b) => a.data.order - b.data.order);
const searchIndex = orderedDocs.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  kicker: entry.data.kicker,
  url: `/docs/${entry.id}/`,
}));
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b12" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/ormate-logo.png" />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem("ormate-docs-theme") || "dark";
    </script>
  </head>
  <body class:list={[`${pageKind}-page`]}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class:list={["topbar", { "home-nav": pageKind === "home" }]}>
      <a class="brand" href="/" aria-label="ormate 首页">
        <img src="/assets/ormate-logo.png" alt="" width="32" height="32" />
        <span>ormate</span>
      </a>
      <nav class="top-actions" aria-label="主导航">
        <a href="/docs/quickstart/">文档</a>
        <button class="search-button" type="button" data-search-open aria-label="搜索文档">搜索 <kbd>/</kbd></button>
        <a href="https://github.com/zzqjlcn/ormate" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="https://pypi.org/project/ormate/" target="_blank" rel="noreferrer">PyPI ↗</a>
        {pageKind === "docs" && <button type="button" data-theme-toggle aria-label="切换颜色主题">◐</button>}
        {pageKind === "docs" && <button class="menu-toggle" type="button" data-menu-toggle aria-label="打开菜单" aria-expanded="false">菜单</button>}
        {pageKind === "home" && <a class="nav-cta" href="/docs/quickstart/">开始使用</a>}
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
      <div class="search-panel">
        <div class="search-field">
          <span aria-hidden="true">⌕</span>
          <label class="sr-only" id="search-title" for="docs-search">搜索文档</label>
          <input id="docs-search" data-search-input type="search" placeholder="搜索 API、事务、Elasticsearch…" autocomplete="off" />
          <kbd>ESC</kbd>
        </div>
        <div class="search-results" data-search-results><p>输入关键词开始搜索文档。</p></div>
        <div class="search-footer"><span>↑↓ 选择</span><span>Enter 打开</span></div>
      </div>
    </dialog>
    <div class="toast" data-toast role="status" aria-live="polite">已复制到剪贴板</div>
    <script is:inline id="search-index" type="application/json" set:html={JSON.stringify(searchIndex)} />
    <script is:inline src="/app.js"></script>
  </body>
</html>
