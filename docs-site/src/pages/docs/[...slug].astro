---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"docs"> }

const { entry } = Astro.props;
const docs = await getCollection("docs");
const orderedDocs = [...docs].sort((a, b) => a.data.order - b.data.order);
const currentIndex = orderedDocs.findIndex((item) => item.id === entry.id);
const previous = currentIndex > 0 ? orderedDocs[currentIndex - 1] : null;
const next = currentIndex < orderedDocs.length - 1 ? orderedDocs[currentIndex + 1] : null;
const { Content, headings } = await render(entry);
const groups = [
  { title: "开始", docs: orderedDocs.filter((item) => item.data.order <= 2) },
  { title: "核心", docs: orderedDocs.filter((item) => item.data.order >= 3 && item.data.order <= 6) },
  { title: "集成", docs: orderedDocs.filter((item) => item.data.order >= 7 && item.data.order <= 10) },
  { title: "状态", docs: orderedDocs.filter((item) => item.data.order === 11) },
];
---

<BaseLayout docs={docs} pageKind="docs" title={`${entry.data.title} · ormate`} description={entry.data.description}>
  <div class="docs-shell">
    <aside class="sidebar" data-sidebar aria-label="文档目录">
      <div class="version">文档 <span>v0.1.2</span></div>
      {groups.map((group) => (
        <section>
          <h2>{group.title}</h2>
          {group.docs.map((item) => <a class:list={{ active: item.id === entry.id }} href={`/docs/${item.id}/`}>{item.id === entry.id && <span aria-hidden="true">—</span>}{item.data.title}</a>)}
        </section>
      ))}
    </aside>

    <main class="doc-main">
      <div class="eyebrow">{entry.data.kicker}</div>
      <article class="prose">
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
        <Content />
      </article>
      <nav class="page-navigation" aria-label="相邻文档">
        {previous ? <a href={`/docs/${previous.id}/`}><span>上一篇</span><strong>← {previous.data.title}</strong></a> : <span></span>}
        {next ? <a href={`/docs/${next.id}/`}><span>下一篇</span><strong>{next.data.title} →</strong></a> : <span></span>}
      </nav>
      <footer class="doc-footer"><span>ormate · MIT License</span><a href="/">返回首页 ↑</a></footer>
    </main>

    <aside class="toc" aria-label="本页目录">
      <strong>本页内容</strong>
      <nav>{headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    </aside>
  </div>
</BaseLayout>
